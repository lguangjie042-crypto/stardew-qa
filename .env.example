# 公网访问时用来签发登录状态，请换成一长串随机字符
SESSION_SECRET=

# 国内公网入口。在 https://www.cpolar.com/ 注册后，把后台的 authtoken 填在这里
CPOLAR_AUTHTOKEN=

# 本机 Ollama。小段写入 Chroma 只做检索；命中后读取整篇 Wiki 原文，对话模型分两步作答。
# 先安装 https://ollama.com ，然后：
#   ollama pull nomic-embed-text
#   ollama pull granite3.2:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_MODEL=granite3.2:8b
# 设为 1 时优先用 Ollama+RAG 回答；模型失败或未就绪时回退到规则/Wiki。默认 0 更稳。
ASK_PREFER_OLLAMA=1

# 可选：没有 Ollama 时，也可接入 OpenAI 兼容接口来润色本地整理的要点
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
